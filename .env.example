# Prompt Vishwakarma needs NO API key to start.
# The engine is Claude Code itself (key-free), via the `claude` CLI in headless mode.
#
# Offline / CI: set PV_RUNNER=fake to use the deterministic fake engine (no model calls).
# PV_RUNNER=fake

# Future (deferred) — only needed once an OpenAI runner / hosted fine-tuning is added:
# OPENAI_API_KEY=
